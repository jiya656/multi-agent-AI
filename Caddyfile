# Site address comes from SITE_ADDRESS.
#   Local test:  :80                (plain HTTP)
#   Real server: yourdomain.com     (Caddy gets an HTTPS certificate by itself)
{$SITE_ADDRESS::80} {
	encode gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# API: slightly above the 10 MB upload limit enforced by the backend
	handle /api/* {
		request_body {
			max_size 12MB
		}
		reverse_proxy backend:5000
	}

	# Live document updates (Socket.IO / WebSocket)
	handle /socket.io/* {
		reverse_proxy backend:5000
	}

	# Everything else: the React app
	handle {
		reverse_proxy frontend:80
	}
}